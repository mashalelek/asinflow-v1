{
  "manifest_version": 3,
  "name": "AsinFlow Capture PO",
  "version": "2.0.3",
  "description": "Capture a retailer checkout or order page into a new AsinFlow PO. Never runs on Amazon (AsinFlow Analyzer does).",
  "permissions": [
    "sidePanel",
    "activeTab",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://asinflow-cqg.onrender.com/*",
    "https://asinflow.coastalqualitygoods.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "AsinFlow Capture PO",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
